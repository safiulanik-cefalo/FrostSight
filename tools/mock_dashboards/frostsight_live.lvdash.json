{
 "datasets": [
  {
   "name": "ds_kpi",
   "displayName": "KPIs",
   "queryLines": [
    "SELECT *, timestampdiff(MINUTE, risk_updated_at, current_timestamp()) AS data_age_minutes FROM kpi_summary\n"
   ]
  },
  {
   "name": "ds_map",
   "displayName": "Road risk",
   "queryLines": [
    "SELECT lat, lon, layer, road, place, icing_score FROM map_points ORDER BY draw_order\n"
   ]
  },
  {
   "name": "ds_stations",
   "displayName": "Stations",
   "queryLines": [
    "SELECT name, status_label, station_status,\n",
    "       timestampdiff(MINUTE, last_event_time, current_timestamp()) AS minutes_since\n",
    "FROM station_status\n",
    "ORDER BY station_status DESC, name\n"
   ]
  },
  {
   "name": "ds_incidents",
   "displayName": "Active incidents",
   "queryLines": [
    "SELECT start_time, incident_type, severity, road_ref, description\n",
    "FROM road_incidents\n",
    "WHERE start_time <= current_timestamp() AND (end_time IS NULL OR end_time > current_timestamp())\n",
    "ORDER BY start_time DESC\n"
   ]
  },
  {
   "name": "ds_rd_header",
   "displayName": "Segment",
   "queryLines": [
    "SELECT segment, icing_score, risk_level, surface_c, change_label, air_c, station_name,\n",
    "       timestampdiff(MINUTE, risk_updated_at, current_timestamp()) AS updated_minutes_ago\n",
    "FROM segment_detail\n"
   ]
  },
  {
   "name": "ds_rd_drivers",
   "displayName": "Drivers",
   "queryLines": [
    "SELECT segment, factor, contribution FROM segment_drivers ORDER BY contribution DESC\n"
   ]
  },
  {
   "name": "ds_rd_types",
   "displayName": "Risk per type",
   "queryLines": [
    "SELECT segment, risk_type, level, score, note FROM segment_risk_types ORDER BY sort_key\n"
   ]
  },
  {
   "name": "ds_rd_history",
   "displayName": "Last 24 hours",
   "queryLines": [
    "SELECT segment, event_time, icing_score, surface_c\n",
    "FROM segment_history\n",
    "WHERE event_time >= timestampadd(HOUR, -24, current_timestamp())\n",
    "ORDER BY event_time\n"
   ]
  },
  {
   "name": "ds_rd_readings",
   "displayName": "Station readings",
   "queryLines": [
    "SELECT segment, reading, value FROM segment_readings ORDER BY sort_key\n"
   ]
  },
  {
   "name": "ds_rd_incidents",
   "displayName": "Incidents on this road",
   "queryLines": [
    "SELECT segment, start_time, incident_type, severity,\n",
    "       CASE WHEN start_time <= current_timestamp() AND (end_time IS NULL OR end_time > current_timestamp())\n",
    "            THEN 'Active' ELSE 'Closed' END AS state,\n",
    "       description\n",
    "FROM segment_incidents\n",
    "WHERE start_time >= timestampadd(HOUR, -48, current_timestamp())\n",
    "ORDER BY start_time DESC\n"
   ]
  },
  {
   "name": "ds_priority",
   "displayName": "Priority",
   "queryLines": [
    "SELECT rank, road, place, level, risk_level, icing_score, surface_c, precip, main_drivers,\n",
    "       timestampdiff(MINUTE, risk_updated_at, current_timestamp()) AS updated_minutes_ago\n",
    "FROM priority_list\n",
    "ORDER BY rank\n"
   ]
  },
  {
   "name": "ds_freshness",
   "displayName": "Freshness",
   "queryLines": [
    "SELECT source,\n",
    "       CASE WHEN last_event_time IS NULL THEN '⚪ NO_DATA'\n",
    "            WHEN timestampdiff(MINUTE, last_event_time, current_timestamp()) > threshold_min THEN '🔴 STALE'\n",
    "            ELSE '🟢 FRESH' END AS status_label,\n",
    "       timestampdiff(MINUTE, last_event_time, current_timestamp()) AS delay_min, threshold_min, last_event_time,\n",
    "       rows_last_24h,\n",
    "       coalesce(CAST(quarantined_last_24h AS STRING), 'Pending Live Data') AS quarantined_last_24h\n",
    "FROM data_quality_summary\n",
    "ORDER BY status_label, source\n"
   ]
  },
  {
   "name": "ds_health_kpi",
   "displayName": "Health KPIs",
   "queryLines": [
    "SELECT latency_median_s FROM kpi_summary\n"
   ]
  },
  {
   "name": "ds_freshness_trend",
   "displayName": "Road-weather delay",
   "queryLines": [
    "SELECT computed_at, ingestion_delay_min, threshold_min\n",
    "FROM data_quality_summary_history\n",
    "WHERE source = 'road_weather' AND computed_at >= timestampadd(HOUR, -24, current_timestamp())\n",
    "ORDER BY computed_at\n"
   ]
  }
 ],
